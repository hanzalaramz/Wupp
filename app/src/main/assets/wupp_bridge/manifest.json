{
  "manifest_version": 2,
  "name": "Wupp Calling Bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "wupp-call-bridge@wupp.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "https://web.whatsapp.com/*",
    "https://*.whatsapp.com/*",
    "https://*.whatsapp.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
